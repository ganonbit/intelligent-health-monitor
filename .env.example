# Copy this to .env and fill in your values

# ============================================
# AI Provider API Keys (at least one required)
# ============================================

# OpenAI API Key (get from https://platform.openai.com/api-keys)
OPENAI_AI_API_KEY=sk-your-openai-key-here

# Anthropic API Key (get from https://console.anthropic.com/)
ANTHROPIC_AI_API_KEY=sk-your-anthropic-key-here

# Google Gemini API Key (get from https://aistudio.google.com/app/apikey)
GEMINI_AI_API_KEY=your-gemini-key-here

# ============================================
# Model Configuration (REQUIRED - no defaults)
# ============================================
# Format: "provider:model-name" or just "model-name"
# The system will automatically use the corresponding API key based on the provider prefix
# More info at https://ai.pydantic.dev/models/overview/

# Examples for ANOMALY_MODEL:
# - OpenAI: openai:gpt-4o-mini, openai:gpt-4o
# - Anthropic: anthropic:claude-3-5-sonnet-20241022, anthropic:claude-3-5-haiku-20241022
# - Gemini: gemini-2.5-flash, gemini-2.5-pro

ANOMALY_MODEL=example-model
ROOT_CAUSE_MODEL=example-model

# ============================================
# Environment Configuration
# ============================================
LOG_LEVEL=INFO
ENVIRONMENT=development
